# Salin ke .env (di folder yang sama dengan docker-compose.yml), lalu ubah nilainya.

# Login untuk membuka SAHAM di browser (format user:sandi). WAJIB diisi bila SAHAM dibuka lewat domain/internet.
# Gunakan sandi panjang & acak, jangan sandi akun lain.
SAHAM_BASIC_AUTH=admin:ganti-dengan-sandi-panjang-dan-acak

# Mode server (sudah diset di image; biarkan 1)
SAHAM_SERVER_MODE=1
